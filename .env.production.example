# Copy to .env on the deployment host. Never commit the real .env file.
POSTGRES_DB=merkato
POSTGRES_USER=merkato_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD

# Generate at least 32 random bytes. Keep this secret outside source control.
JWT_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ISSUER=https://api.your-domain.example
JWT_AUDIENCE=https://your-domain.example
JWT_EXPIRY_MINUTES=30

# Exact public HTTPS origin(s), separated by semicolons.
MERKATO_ALLOWED_ORIGINS=https://your-domain.example
MERKATO_DOMAIN=merkato.example.com

# Optional: set only during first administrator provisioning, then remove.
MERKATO_ADMIN_PHONE=
MERKATO_ADMIN_PIN=
MERKATO_ADMIN_NAME=Marketplace Administrator

# Durable product and creator-media storage (Cloudinary). Configure these as host secrets.
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Keep payment secrets empty until official provider credentials and signed webhook specs are configured.
TELEBIRR_WEBHOOK_SECRET=
CBEBIRR_WEBHOOK_SECRET=

# Commission defaults; approve business rates before enabling non-zero merchant fees.
Commissions__CreatorRatePercent=5
Commissions__AffiliateRatePercent=2
