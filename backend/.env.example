# MERKATO Backend Environment Configuration (Production & Staging Template)
# Populate only with environment-specific values. Never commit real secrets.
ConnectionStrings__PostgreSql=
Jwt__Key=
Jwt__Issuer=https://api.merkato.et
Jwt__Audience=https://merkato.et
Jwt__ExpiryMinutes=60
TELEBIRR_API_URL=
TELEBIRR_API_KEY=
TELEBIRR_WEBHOOK_SECRET=
TELEBIRR_MERCHANT_CODE=
CBEBIRR_API_URL=
CBEBIRR_API_KEY=
CBEBIRR_WEBHOOK_SECRET=
CBEBIRR_MERCHANT_ID=

# Chapa seller split uses the currently documented v1 split endpoints; keep disabled until Chapa approval and sandbox/live-mode constraints are confirmed.
Chapa__Enabled=false
Chapa__BaseUrl=https://api.chapa.co/v1
Chapa__SecretKey=
Chapa__WebhookSecret=
Chapa__CallbackUrl=https://merkato.aclclouds.online/api/Payments/chapa/callback
Chapa__ReturnUrl=https://merkato.aclclouds.online/checkout/payment-return
Chapa__TimeoutSeconds=20
Chapa__RequireSignedWebhooks=true
FAYDA_API_URL=
FAYDA_CLIENT_ID=
FAYDA_CLIENT_SECRET=
FAYDA_CERT_PATH=
FAYDA_KEY_PATH=
MERKATO_ADMIN_PHONE=
MERKATO_ADMIN_PIN=
MERKATO_ADMIN_NAME=Marketplace Administrator
MERKATO_ADMIN_EMAIL=
MERKATO_ADMIN_PASSWORD= # Set a unique password of at least 14 characters; never commit real credentials.
MERKATO_ALLOWED_ORIGINS=http://localhost:4200;https://merkato.et;https://www.merkato.et

# Required for durable product images and direct Social Commerce image/video uploads
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Optional OpenAI-compatible shopping assistant provider
MERKATO_AI_API_KEY=
MERKATO_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
MERKATO_AI_MODEL=gpt-4o-mini

# Commission defaults (eligible product subtotal only; delivery excluded)
Commissions__CreatorRatePercent=5
Commissions__AffiliateRatePercent=2
